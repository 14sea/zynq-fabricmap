# B3 firmware — host twins only (image stage 1: the cartographer; stage 2: the O arm's record, ledger and
# combined commitment, with its online view).
#
# `make twin` builds the HOST driver (b3_carto_twin.c + b3_carto.c) that b3/tests/test_b3_carto_twin.py
# drives against b3/host/b3_carto.py. It is host tooling, not a board image; nothing here is
# cross-compiled (the board application and its build evidence are later stages).
#
# Build products go to the repository's top-level ignored build/ directory, never under b3/: the B3
# pin rule pins every regular file under b3/**/*, and a build product is not a pinned source.
#
# The cartographer is compiled with the board build's warning flags (-Wall -Wextra) plus -pedantic,
# -Wshadow, -Wstrict-prototypes, -Wmissing-prototypes, -Wconversion and -Werror: a construct the
# board compiler tolerates but the standard does not is still a defect here, and the unit must be
# clean under the strictest host warnings before it is ever cross-compiled.

CC      ?= cc
CFLAGS  ?= -std=c99 -O2 -Wall -Wextra -Werror -pedantic -Wshadow -Wstrict-prototypes -Wmissing-prototypes -Wconversion
BUILD   ?= $(abspath $(CURDIR)/../../build/b3_firmware)

.PHONY: twin record-twin wire-twin wire-parity orch-twin clean
twin: $(BUILD)/b3_carto_twin

$(BUILD)/b3_carto_twin: b3_carto_twin.c b3_carto.c b3_carto.h
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -o $@ b3_carto_twin.c b3_carto.c

# Stage 2: `make record-twin` builds the O arm's host driver (b3/tests/test_b3_record_twin.py) from the
# stage-1 cartographer, the new record / online-view units and the byte-for-byte copies of B2's search
# and hash units (b2_search.*, p3_derive.*, p3_data.h — equal to firmware/b2/, held by the test).
RECORD_SRC = b3_record_twin.c b3_record.c b3_online_view.c b3_carto.c b2_search.c p3_derive.c
RECORD_HDR = b3_record.h b3_online_view.h b3_carto.h b2_search.h p3_derive.h p3_data.h
record-twin: $(BUILD)/b3_record_twin

$(BUILD)/b3_record_twin: $(RECORD_SRC) $(RECORD_HDR)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -o $@ $(RECORD_SRC)

# Stage 3: `make wire-twin` builds the host driver that puts this image's wire bytes (b3_wire.c, derived from
# firmware/b2/b2_wire.c) in front of the production validator; `make wire-parity` builds ONE parity driver
# twice — against firmware/b2/b2_wire.c (-DWIRE_B2) and against b3_wire.c — for the B2 / B3 byte parity of
# every public builder the derivation does not change (b3/tests/test_b3_wire_contract.py).
WIRE_SRC = b3_wire_twin.c b3_wire.c b3_record.c b3_online_view.c b3_carto.c b2_search.c p3_derive.c
WIRE_HDR = b3_wire.h b3_record.h b3_online_view.h b3_carto.h b2_search.h p3_derive.h p3_data.h
B2FW    = $(abspath $(CURDIR)/../../firmware/b2)
wire-twin: $(BUILD)/b3_wire_twin
wire-parity: $(BUILD)/b3_wire_parity_b2 $(BUILD)/b3_wire_parity_b3

$(BUILD)/b3_wire_twin: $(WIRE_SRC) $(WIRE_HDR)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -o $@ $(WIRE_SRC)

$(BUILD)/b3_wire_parity_b3: b3_wire_parity.c b3_wire.c b3_wire.h p3_derive.c p3_derive.h
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -o $@ b3_wire_parity.c b3_wire.c p3_derive.c

$(BUILD)/b3_wire_parity_b2: b3_wire_parity.c $(B2FW)/b2_wire.c $(B2FW)/b2_wire.h $(B2FW)/p3_derive.c $(B2FW)/p3_derive.h
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) -DWIRE_B2 -I$(B2FW) -o $@ b3_wire_parity.c $(B2FW)/b2_wire.c $(B2FW)/p3_derive.c

# Stage 4: `make orch-twin` builds the orchestrator's host driver, LINKED WITH --wrap on both initializers so the
# twin logs every call the orchestrator makes to b2_search_init and b3_online_init (the actual path the O arm
# takes, held by b3/tests/test_b3_orch_twin.py). b3_seed_data.h is generated by b3/host/gen_b3_seed_data.py.
ORCH_SRC = b3_orch_twin.c b3_orch.c b3_record.c b3_online_view.c b3_carto.c b2_search.c p3_derive.c
ORCH_HDR = b3_orch.h b3_seed_data.h b3_wire.h b3_record.h b3_online_view.h b3_carto.h b2_search.h p3_derive.h p3_data.h
ORCH_WRAP = -Wl,--wrap=b2_search_init -Wl,--wrap=b3_online_init
orch-twin: $(BUILD)/b3_orch_twin

$(BUILD)/b3_orch_twin: $(ORCH_SRC) $(ORCH_HDR)
	@mkdir -p $(BUILD)
	$(CC) $(CFLAGS) $(ORCH_WRAP) -o $@ $(ORCH_SRC)

clean:
	rm -rf $(BUILD)
