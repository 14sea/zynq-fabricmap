{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ff_observation_model_raw_v1.schema.json",
 "title": "M-raw \u2014 the legacy raw model trace as b4_ff_model.Fabric.observe() writes it (contract 3.2)",
 "x-contract": "the model branch: null cells allowed; config a dictionary address -> bit; no stimulus_sha256 field; config_sha256 over the dictionary under Python's default separators (raw-dict-default). The adapter host/b4q_view.py reads it; it is NOT an instance of the view schema.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "schema_version",
  "visibility",
  "q_null_means",
  "hypothesis",
  "mapping",
  "fabric",
  "config",
  "config_sha256",
  "stimulus",
  "initial",
  "elements",
  "steps"
 ],
 "properties": {
  "schema": {
   "const": "b4_ff_observation_trace"
  },
  "schema_version": {
   "const": "0.2.0"
  },
  "visibility": {
   "const": "executing_side"
  },
  "q_null_means": {
   "type": "string"
  },
  "hypothesis": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "sha256",
    "version",
    "fixture"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "[0-9a-f]{64}"
    },
    "version": {
     "type": "string"
    },
    "fixture": {
     "type": "boolean"
    }
   }
  },
  "mapping": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "site",
    "certificate",
    "certificate_sha256"
   ],
   "properties": {
    "site": {
     "type": "string"
    },
    "certificate": {
     "type": "string"
    },
    "certificate_sha256": {
     "type": "string",
     "pattern": "[0-9a-f]{64}"
    }
   }
  },
  "fabric": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "effect_sha256",
    "dropout_sha256",
    "dropout_count",
    "seed"
   ],
   "properties": {
    "kind": {
     "enum": [
      "truth",
      "permuted",
      "dropout",
      "custom"
     ]
    },
    "effect_sha256": {
     "type": "string",
     "pattern": "[0-9a-f]{64}"
    },
    "dropout_sha256": {
     "type": "string",
     "pattern": "[0-9a-f]{64}"
    },
    "dropout_count": {
     "type": "integer",
     "minimum": 0
    },
    "seed": {
     "type": [
      "integer",
      "null"
     ]
    }
   }
  },
  "config": {
   "type": "object"
  },
  "config_sha256": {
   "type": "string",
   "pattern": "[0-9a-f]{64}"
  },
  "stimulus": {
   "type": "array",
   "minItems": 1,
   "items": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind"
      ],
      "properties": {
       "kind": {
        "const": "init"
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "clock",
       "ce",
       "sr",
       "d"
      ],
      "properties": {
       "kind": {
        "const": "set"
       },
       "clock": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
       },
       "ce": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "sr": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       },
       "d": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
       }
      }
     }
    ]
   }
  },
  "initial": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "clock",
    "ce",
    "sr",
    "d",
    "q"
   ],
   "properties": {
    "clock": {
     "type": "integer",
     "minimum": 0,
     "maximum": 1
    },
    "ce": {
     "type": "integer",
     "minimum": 0,
     "maximum": 255
    },
    "sr": {
     "type": "integer",
     "minimum": 0,
     "maximum": 255
    },
    "d": {
     "type": "integer",
     "minimum": 0,
     "maximum": 255
    },
    "q": {
     "type": "array",
     "minItems": 8,
     "maxItems": 8,
     "items": {
      "type": [
       "integer",
       "null"
      ],
      "minimum": 0,
      "maximum": 1
     }
    }
   }
  },
  "elements": {
   "type": "array",
   "minItems": 8,
   "maxItems": 8,
   "items": {
    "enum": [
     "AFF",
     "A5FF",
     "BFF",
     "B5FF",
     "CFF",
     "C5FF",
     "DFF",
     "D5FF"
    ]
   }
  },
  "steps": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "step",
     "kind",
     "prev_event",
     "clock_before",
     "clock_after",
     "edge",
     "ce",
     "sr",
     "d",
     "q_before",
     "q_after"
    ],
    "properties": {
     "step": {
      "type": "integer",
      "minimum": 0
     },
     "kind": {
      "enum": [
       "init",
       "set"
      ]
     },
     "prev_event": {
      "enum": [
       "none",
       "init",
       "edge",
       "level"
      ]
     },
     "clock_before": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
     },
     "clock_after": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
     },
     "edge": {
      "enum": [
       "rising",
       "falling",
       null
      ]
     },
     "ce": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
     },
     "sr": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
     },
     "d": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
     },
     "q_before": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "maximum": 1
      }
     },
     "q_after": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
       "type": [
        "integer",
        "null"
       ],
       "minimum": 0,
       "maximum": 1
      }
     }
    }
   }
  }
 }
}
