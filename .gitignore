# read-only copies of sibling projects, mined for reference only — never committed
external/
# copyrighted reference PDFs
ref/
# hot-loop CSV / telemetry logs
runs/
# vendored soft-core / toolchain trees
rtl_src/
sw_src/
# python / build noise
__pycache__/
*.pyc
.env/
# vivado / build outputs
build/
*.jou
*.log
*.str
.Xil/
hd_visual/
# write_bitstream drops this in whatever directory Vivado was launched from
clockInfo.txt
# Evidence is not build noise. `*.log` above is for Vivado, and it was silently swallowing
# the step 1 load evidence the location sweep's run book requires to be kept (fclk50.log,
# carrier_load.log, the acquisition's stdout). Anything under evidence/ is a record.
!evidence/**/*.log

# board capture scratch
*.raw

# Claim B round 1′: ruling files are written by the owner per session and consumed once; never committed (the instrument keeps the same rule)
rulings/

# B1 image build products: rebuilt byte-identically by firmware/b1/bsp/build.sh and pinned by hash in
# manifests/b1_manifest.json + evidence/b1/build_evidence.json (the instrument keeps the same rule)
firmware/b1/bsp/out/
firmware/b1/build/

# B1 carrier build: the bitstream, build record, carrier manifest, isolation and reports are committed
# (the instrument keeps the same rule for builds/p3); the checkpoints and the raw Vivado stdout are not
builds/b1/*.dcp
builds/b1/build.stdout

# iverilog products of sim/b1/run.sh
sim/b1/out/
