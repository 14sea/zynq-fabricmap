        "unattributed_diff": {
          "type": "array",
          "items": {"$ref": "#/$defs/unattributed_diff_bit"}
        },
        "exclusion_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/exclusion_rule"}
        },
        "excluded_diff": {
          "type": "array",
          "items": {"$ref": "#/$defs/excluded_diff_bit"}
        },
        "verdict": {"enum": ["matched", "mismatched"]}
      }
    }
  }
}
