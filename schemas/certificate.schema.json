{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/14sea/zynq-fabricmap/schemas/certificate.schema.json",
  "title": "Zynq fabric bit-class certificate",
  "description": "Consumer-owned record emitted by the specimen-diff prediction gate. This schema validates the feature evidence model through 1.2.0 and the additive group evidence model introduced in 1.3.0. Unknown fields are permitted so 1.x consumers can ignore later MINOR additions.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "certificate_id",
    "status",
    "failure_reasons",
    "gate_run",
    "target",
    "frozen_inputs",
    "bit_class",
    "specimens"
  ],
  "properties": {
    "schema": {"const": "fabric_bit_class_certificate"},
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "evidence_model": {"enum": ["feature", "group"]},
    "profile": {"enum": ["conformance", "production"]},
    "prediction_commitment": {"$ref": "#/$defs/prediction_commitment"},
    "certificate_id": {"$ref": "#/$defs/nonempty_string"},
    "status": {"enum": ["passed", "failed"]},
    "failure_reasons": {
      "type": "array",
      "items": {"$ref": "#/$defs/failure_reason"}
    },
    "gate_run": {
      "type": "object",
      "required": ["gate_id", "started_at", "completed_at", "tool_versions"],
      "properties": {
        "gate_id": {"$ref": "#/$defs/nonempty_string"},
        "started_at": {"$ref": "#/$defs/timestamp"},
        "completed_at": {"$ref": "#/$defs/timestamp"},
        "tool_versions": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/nonempty_string"}
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["family", "device", "part"],
      "properties": {
        "family": {"$ref": "#/$defs/nonempty_string"},
        "device": {"$ref": "#/$defs/nonempty_string"},
        "part": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "frozen_inputs": {
      "type": "object",
      "required": ["manifest_schema_version", "freeze_stamp", "spec", "files"],
      "properties": {
        "manifest_schema_version": {"$ref": "#/$defs/semver"},
        "freeze_stamp": {"$ref": "#/$defs/timestamp"},
        "spec": {"$ref": "#/$defs/pinned_file"},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pinned_file"}
        }
      }
    },
    "bit_class": {"type": "object"},
    "specimens": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object"}
    },
    "feature_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feature_result"}
    },
    "claim_scope": {"enum": ["group_bit_set", "tile"]},
    "semantic_status": {"enum": ["passed", "failed"]},
    "group_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/group_result"}
    },
    "pair_accounting": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pair_accounting"}
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["evidence_model"],
        "properties": {"evidence_model": {"const": "group"}}
      },
      "then": {
        "required": [
          "claim_scope",
          "semantic_status",
          "group_results",
          "pair_accounting",
          "prediction_commitment"
        ],
        "properties": {
          "schema_version": {"pattern": "^1\\.(?:[3-9]|[1-9][0-9]+)\\.[0-9]+$"},
          "bit_class": {"$ref": "#/$defs/group_bit_class"},
          "specimens": {"items": {"$ref": "#/$defs/group_specimen"}}
        }
      },
      "else": {
        "required": ["feature_results"],
        "properties": {
          "bit_class": {"$ref": "#/$defs/feature_bit_class"},
          "specimens": {"items": {"$ref": "#/$defs/specimen"}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "passed"}}},
      "then": {"properties": {"failure_reasons": {"maxItems": 0}}},
      "else": {"properties": {"failure_reasons": {"minItems": 1}}}
    },
    {
      "if": {
        "required": ["profile"],
        "properties": {"profile": {"const": "production"}}
      },
      "then": {
        "properties": {
          "specimens": {
            "items": {"required": ["attestation"]}
          },
          "feature_results": {
            "items": {"required": ["exclusion_rules", "excluded_diff"]}
          }
        }
      }
    },
    {
      "if": {
        "required": ["profile", "schema_version"],
        "properties": {
          "profile": {"const": "production"},
          "schema_version": {"pattern": "^1\\.(?:[2-9]|[1-9][0-9]+)\\.[0-9]+$"}
        }
      },
      "then": {
        "required": ["prediction_commitment"],
        "properties": {
          "feature_results": {
            "items": {
              "required": ["prediction_specimen_id", "expected_transition"],
              "properties": {
                "predicted_assignments": {
                  "items": {"required": ["token"]}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonempty_string": {"type": "string", "minLength": 1},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "far": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"},
    "feature_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty_string"}
    },
    "nonempty_feature_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty_string"}
    },
    "feature_bit_class": {
      "type": "object",
      "required": ["id", "tier", "manifest_entries", "split", "coverage", "accounting", "decision_rule"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty_string"},
        "tier": {"enum": ["content", "routing"]},
        "manifest_entries": {"type": "integer", "minimum": 0},
        "split": {
          "type": "object",
          "required": ["mine_features", "holdout_features"],
          "properties": {
            "mine_features": {"$ref": "#/$defs/feature_list"},
            "holdout_features": {"$ref": "#/$defs/nonempty_feature_list"}
          }
        },
        "coverage": {"$ref": "#/$defs/coverage"},
        "accounting": {
          "type": "object",
          "required": ["tp_count", "fp_count", "fn_count"],
          "properties": {
            "tp_count": {"type": "integer", "minimum": 0},
            "fp_count": {"type": "integer", "minimum": 0},
            "fn_count": {"type": "integer", "minimum": 0}
          }
        },
        "decision_rule": {"const": "holdout_exact_match: fp_count == 0 and fn_count == 0"}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["attested_count", "class_entry_count"],
      "properties": {
        "attested_count": {"type": "integer", "minimum": 0},
        "class_entry_count": {"type": "integer", "minimum": 0}
      }
    },
    "pass_fail_count": {
      "type": "object",
      "required": ["pass_count", "fail_count"],
      "properties": {
        "pass_count": {"type": "integer", "minimum": 0},
        "fail_count": {"type": "integer", "minimum": 0}
      }
    },
    "group_bit_class": {
      "type": "object",
      "required": [
        "id",
        "tier",
        "manifest_entries",
        "split",
        "coverage",
        "address_accounting",
        "semantic_accounting",
        "decision_rule",
        "semantic_rule"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty_string"},
        "tier": {"enum": ["content", "routing"]},
        "manifest_entries": {"type": "integer", "minimum": 0},
        "split": {
          "type": "object",
          "required": ["mine_groups", "holdout_groups"],
          "properties": {
            "mine_groups": {"$ref": "#/$defs/feature_list"},
            "holdout_groups": {"$ref": "#/$defs/nonempty_feature_list"}
          }
        },
        "coverage": {"$ref": "#/$defs/coverage"},
        "address_accounting": {
          "type": "object",
          "required": ["group_exclusivity", "scope_assignment"],
          "properties": {
            "group_exclusivity": {"$ref": "#/$defs/pass_fail_count"},
            "scope_assignment": {"$ref": "#/$defs/pass_fail_count"}
          }
        },
        "semantic_accounting": {
          "type": "object",
          "required": ["member_identity"],
          "properties": {
            "member_identity": {"$ref": "#/$defs/pass_fail_count"}
          }
        },
        "decision_rule": {
          "const": "holdout_address_assertions: group_exclusivity.fail_count == 0 and scope_assignment.fail_count == 0"
        },
        "semantic_rule": {
          "const": "member_identity is reported independently and never contributes to status"
        }
      }
    },
    "failure_reason": {
      "type": "object",
      "required": ["code", "detail"],
      "properties": {
        "code": {
          "enum": [
            "holdout_false_positive",
            "holdout_false_negative",
            "holdout_group_exclusivity",
            "holdout_scope_assignment",
            "partition_integrity",
            "tile_ownership_unknown",
            "incomplete_coverage",
            "stale_frozen_input",
            "specimen_build_error",
            "tool_error",
            "other"
          ]
        },
        "detail": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "pinned_file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty_string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "attestation_ref": {
      "type": "object",
      "required": ["path", "sha256", "schema_version"],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty_string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "group_attestation_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "schema_version",
        "resolved_loc",
        "resolved_bel",
        "pin_mapping_is_identity",
        "checkpoint"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty_string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "resolved_loc": {"$ref": "#/$defs/nonempty_string"},
        "resolved_bel": {"$ref": "#/$defs/nonempty_string"},
        "pin_mapping_is_identity": {"type": "boolean"},
        "checkpoint": {"$ref": "#/$defs/checkpoint"}
      }
    },
    "prediction_totals": {
      "type": "object",
      "required": ["specimens", "predictions", "holdout_predictions"],
      "properties": {
        "specimens": {"type": "integer", "minimum": 1},
        "predictions": {"type": "integer", "minimum": 1},
        "holdout_predictions": {"type": "integer", "minimum": 1}
      }
    },
    "prediction_commitment": {
      "type": "object",
      "required": ["run_id", "path", "sha256", "schema_version", "seed", "totals"],
      "properties": {
        "run_id": {"$ref": "#/$defs/nonempty_string"},
        "path": {"$ref": "#/$defs/nonempty_string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "seed": {"$ref": "#/$defs/nonempty_string"},
        "totals": {"$ref": "#/$defs/prediction_totals"}
      }
    },
    "address": {
      "type": "object",
      "required": ["far", "word", "bit"],
      "properties": {
        "far": {"$ref": "#/$defs/far"},
        "word": {"type": "integer", "minimum": 0, "maximum": 100},
        "bit": {"type": "integer", "minimum": 0, "maximum": 31}
      }
    },
    "checkpoint": {
      "type": "object",
      "required": ["file", "sha256"],
      "properties": {
        "file": {"$ref": "#/$defs/nonempty_string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "group_scope_bit": {
      "type": "object",
      "required": ["segbit", "address"],
      "properties": {
        "segbit": {"type": "string", "pattern": "^[0-9]{2}_[0-9]{2}$"},
        "address": {"$ref": "#/$defs/address"}
      }
    },
    "group_expected_bit": {
      "type": "object",
      "required": ["segbit", "address", "expected_value"],
      "properties": {
        "segbit": {"type": "string", "pattern": "^[0-9]{2}_[0-9]{2}$"},
        "address": {"$ref": "#/$defs/address"},
        "expected_value": {"enum": [0, 1]}
      }
    },
    "group_observed_bit": {
      "type": "object",
      "required": ["segbit", "address", "expected_value", "observed_value"],
      "properties": {
        "segbit": {"type": "string", "pattern": "^[0-9]{2}_[0-9]{2}$"},
        "address": {"$ref": "#/$defs/address"},
        "expected_value": {"enum": [0, 1]},
        "observed_value": {"enum": [0, 1]}
      }
    },
    "group_assertion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "semantic", "claim"],
          "properties": {
            "kind": {"const": "group_exclusivity"},
            "semantic": {"const": false},
            "claim": {"$ref": "#/$defs/nonempty_string"}
          }
        },
        {
          "type": "object",
          "required": ["kind", "semantic", "claim", "expected_assignment"],
          "properties": {
            "kind": {"const": "scope_assignment"},
            "semantic": {"const": false},
            "claim": {"$ref": "#/$defs/nonempty_string"},
            "expected_assignment": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/group_expected_bit"}
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "semantic", "claim", "predicted_member", "netlist_basis"],
          "properties": {
            "kind": {"const": "member_identity"},
            "semantic": {"const": true},
            "claim": {"$ref": "#/$defs/nonempty_string"},
            "predicted_member": {"$ref": "#/$defs/nonempty_string"},
            "netlist_basis": {"$ref": "#/$defs/nonempty_string"}
          }
        }
      ]
    },
    "attested_edge": {
      "type": "object",
      "required": [
        "ff_bel",
        "ff_d_net",
        "ff_d_driver_pin",
        "ff_d_driver_cell",
        "ff_d_driver_ref",
        "ff_d_source_port",
        "ff_d_source_package_pin",
        "ff_d_net_route_status",
        "checkpoint"
      ],
      "properties": {
        "ff_bel": {"$ref": "#/$defs/nonempty_string"},
        "ff_d_net": {"$ref": "#/$defs/nonempty_string"},
        "ff_d_driver_pin": {"$ref": "#/$defs/nonempty_string"},
        "ff_d_driver_cell": {"$ref": "#/$defs/nonempty_string"},
        "ff_d_driver_ref": {"$ref": "#/$defs/nonempty_string"},
        "ff_d_source_port": {"type": "string"},
        "ff_d_source_package_pin": {"type": "string"},
        "ff_d_net_route_status": {"$ref": "#/$defs/nonempty_string"},
        "checkpoint": {"$ref": "#/$defs/checkpoint"}
      }
    },
    "assertion_outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "semantic", "passed", "decoded_members"],
          "properties": {
            "kind": {"const": "group_exclusivity"},
            "semantic": {"const": false},
            "passed": {"type": "boolean"},
            "decoded_members": {"$ref": "#/$defs/feature_list"}
          }
        },
        {
          "type": "object",
          "required": ["kind", "semantic", "passed", "mismatched"],
          "properties": {
            "kind": {"const": "scope_assignment"},
            "semantic": {"const": false},
            "passed": {"type": "boolean"},
            "mismatched": {"type": "array", "items": {"$ref": "#/$defs/address"}}
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "semantic",
            "passed",
            "predicted_member",
            "decoded_members",
            "netlist_basis",
            "expected_edge",
            "attested_edge",
            "netlist_basis_consistent"
          ],
          "properties": {
            "kind": {"const": "member_identity"},
            "semantic": {"const": true},
            "passed": {"type": "boolean"},
            "predicted_member": {"$ref": "#/$defs/nonempty_string"},
            "decoded_members": {"$ref": "#/$defs/feature_list"},
            "netlist_basis": {"$ref": "#/$defs/nonempty_string"},
            "expected_edge": {"type": "object"},
            "attested_edge": {"$ref": "#/$defs/attested_edge"},
            "netlist_basis_consistent": {"type": "boolean"}
          }
        }
      ]
    },
    "group_result": {
      "type": "object",
      "required": [
        "prediction_specimen_id",
        "group",
        "split",
        "rule_file",
        "scope",
        "assertions",
        "decoded_members",
        "observed_assignment",
        "assertion_outcomes"
      ],
      "properties": {
        "prediction_specimen_id": {"$ref": "#/$defs/nonempty_string"},
        "group": {"$ref": "#/$defs/nonempty_string"},
        "split": {"enum": ["mine", "holdout"]},
        "rule_file": {"$ref": "#/$defs/nonempty_string"},
        "scope": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/group_scope_bit"}},
        "assertions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/group_assertion"}
        },
        "decoded_members": {"$ref": "#/$defs/feature_list"},
        "observed_assignment": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/group_observed_bit"}
        },
        "assertion_outcomes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/assertion_outcome"}
        }
      }
    },
    "group_specimen": {
      "type": "object",
      "required": [
        "specimen_id",
        "split",
        "site",
        "ff_bel",
        "ffsrc",
        "tile",
        "tile_type",
        "bitstream_sha256",
        "attestation"
      ],
      "properties": {
        "specimen_id": {"$ref": "#/$defs/nonempty_string"},
        "split": {"enum": ["mine", "holdout"]},
        "site": {"$ref": "#/$defs/nonempty_string"},
        "ff_bel": {"$ref": "#/$defs/nonempty_string"},
        "ffsrc": {"enum": [0, 1]},
        "tile": {"$ref": "#/$defs/nonempty_string"},
        "tile_type": {"$ref": "#/$defs/nonempty_string"},
        "bitstream_sha256": {"$ref": "#/$defs/sha256"},
        "attestation": {"$ref": "#/$defs/group_attestation_ref"}
      }
    },
    "bucket_counts": {
      "type": "object",
      "required": ["in_scope", "frame_ecc", "db_attributed", "ownership_unknown", "unattributed"],
      "properties": {
        "in_scope": {"type": "integer", "minimum": 0},
        "frame_ecc": {"type": "integer", "minimum": 0},
        "db_attributed": {"type": "integer", "minimum": 0},
        "ownership_unknown": {"type": "integer", "minimum": 0},
        "unattributed": {"type": "integer", "minimum": 0}
      }
    },
    "bucket_bits": {
      "type": "object",
      "required": ["in_scope", "frame_ecc", "db_attributed", "ownership_unknown", "unattributed"],
      "properties": {
        "in_scope": {"type": "array", "items": {"$ref": "#/$defs/address"}},
        "frame_ecc": {"type": "array", "items": {"$ref": "#/$defs/address"}},
        "db_attributed": {"type": "array", "items": {"$ref": "#/$defs/address"}},
        "ownership_unknown": {"type": "array", "items": {"$ref": "#/$defs/address"}},
        "unattributed": {"type": "array", "items": {"$ref": "#/$defs/address"}}
      }
    },
    "pair_accounting": {
      "type": "object",
      "required": ["site", "ff_bel", "specimen_ids", "raw_diff_bits", "counts", "buckets", "partition_exact"],
      "properties": {
        "site": {"$ref": "#/$defs/nonempty_string"},
        "ff_bel": {"$ref": "#/$defs/nonempty_string"},
        "specimen_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty_string"}
        },
        "raw_diff_bits": {"type": "integer", "minimum": 0},
        "counts": {"$ref": "#/$defs/bucket_counts"},
        "buckets": {"$ref": "#/$defs/bucket_bits"},
        "partition_exact": {"type": "boolean"}
      }
    },
    "predicted_assignment": {
      "type": "object",
      "required": ["segbit", "address", "expected_value"],
      "properties": {
        "token": {"$ref": "#/$defs/nonempty_string"},
        "segbit": {
          "type": "object",
          "required": ["frame_offset", "bit_offset", "negated"],
          "properties": {
            "frame_offset": {"type": "integer", "minimum": 0},
            "bit_offset": {"type": "integer", "minimum": 0, "maximum": 63},
            "negated": {"type": "boolean"}
          }
        },
        "address": {"$ref": "#/$defs/address"},
        "expected_value": {"enum": [0, 1]}
      }
    },
    "expected_transition": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {
        "before": {"enum": [0, 1]},
        "after": {"enum": [0, 1]}
      }
    },
    "observed_assignment": {
      "type": "object",
      "required": ["address", "observed_value"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "observed_value": {"enum": [0, 1]}
      }
    },
    "diff_bit": {
      "type": "object",
      "required": ["address", "before_value", "after_value"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "before_value": {"enum": [0, 1]},
        "after_value": {"enum": [0, 1]}
      }
    },
    "unattributed_diff_bit": {
      "type": "object",
      "required": ["address", "before_value", "after_value", "listed_in_frozen_mask"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "before_value": {"enum": [0, 1]},
        "after_value": {"enum": [0, 1]},
        "listed_in_frozen_mask": {"type": "boolean"}
      }
    },
    "exclusion_rule": {
      "type": "object",
      "required": ["reason", "rule", "why"],
      "properties": {
        "reason": {"const": "frame_ecc"},
        "rule": {"const": "word == 50 and 0 <= bit <= 12"},
        "why": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "excluded_diff_bit": {
      "type": "object",
      "required": ["address", "before_value", "after_value", "reason", "rule"],
      "properties": {
        "address": {"$ref": "#/$defs/address"},
        "before_value": {"enum": [0, 1]},
        "after_value": {"enum": [0, 1]},
        "reason": {"const": "frame_ecc"},
        "rule": {"const": "word == 50 and 0 <= bit <= 12"}
      }
    },
    "specimen": {
      "type": "object",
      "required": [
        "specimen_id",
        "split",
        "design_source_sha256",
        "vivado_version",
        "part",
        "loc_site",
        "tile",
        "tile_type",
        "tile_frame_base",
        "build_seed",
        "bitstream_sha256"
      ],
      "properties": {
        "specimen_id": {"$ref": "#/$defs/nonempty_string"},
        "split": {"enum": ["mine", "holdout"]},
        "design_source_sha256": {"$ref": "#/$defs/sha256"},
        "vivado_version": {"$ref": "#/$defs/nonempty_string"},
        "part": {"$ref": "#/$defs/nonempty_string"},
        "loc_site": {"$ref": "#/$defs/nonempty_string"},
        "tile": {"$ref": "#/$defs/nonempty_string"},
        "tile_type": {"$ref": "#/$defs/nonempty_string"},
        "tile_frame_base": {"$ref": "#/$defs/far"},
        "build_seed": {"type": "integer", "minimum": 0},
        "bitstream_sha256": {"$ref": "#/$defs/sha256"},
        "attestation": {"$ref": "#/$defs/attestation_ref"}
      }
    },
    "feature_result": {
      "type": "object",
      "dependentRequired": {
        "exclusion_rules": ["excluded_diff"],
        "excluded_diff": ["exclusion_rules"]
      },
      "required": [
        "feature",
        "split",
        "rule_file",
        "baseline_specimen_id",
        "feature_specimen_id",
        "predicted_assignments",
        "observed_assignments",
        "observed_diff",
        "unattributed_diff",
        "verdict"
      ],
      "properties": {
        "feature": {"$ref": "#/$defs/nonempty_string"},
        "prediction_specimen_id": {"$ref": "#/$defs/nonempty_string"},
        "split": {"enum": ["mine", "holdout"]},
        "rule_file": {"$ref": "#/$defs/nonempty_string"},
        "baseline_specimen_id": {"$ref": "#/$defs/nonempty_string"},
        "feature_specimen_id": {"$ref": "#/$defs/nonempty_string"},
        "predicted_assignments": {
          "type": "array",
          "items": {"$ref": "#/$defs/predicted_assignment"}
        },
        "expected_transition": {"$ref": "#/$defs/expected_transition"},
        "observed_assignments": {
          "type": "array",
          "items": {"$ref": "#/$defs/observed_assignment"}
        },
        "observed_diff": {
          "type": "array",
          "items": {"$ref": "#/$defs/diff_bit"}
