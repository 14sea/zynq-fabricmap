{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/14sea/zynq-fabricmap/schemas/specimen_ledger.schema.json",
  "title": "specimen_ledger 1.0.0 — every evaluation of the closed loop as a specimen, and the map version it produced",
  "description": "Stage B3 (docs/b3_architecture.md). Written by the board's online arm, one entry per evaluation: the map version the operator consulted, the parent, the intervention (the genome bits flipped), the behaviour delta (the readout positions that toggled relative to the parent), the fitness, the specimen's confidence (2 = a single-bit intervention, decoding directly; 1 = multi-bit, narrowing candidate sets), and the addresses this specimen decoded. The ledger is the evidence chain of the online map: replaying it from the first entry reproduces every map version.",
  "type": "object",
  "required": ["schema", "schema_version", "binding", "seed", "fitness", "budget", "entries", "final_map_version", "anomalies"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "specimen_ledger"},
    "schema_version": {"const": "1.0.0"},
    "binding": {
      "type": "object", "required": ["token", "universe_sha256", "image_sha256_lo32", "landscape_seed"], "additionalProperties": false,
      "properties": {
        "token": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "universe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "image_sha256_lo32": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
        "landscape_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}
      }
    },
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295, "description": "the operator seed"},
    "fitness": {"enum": ["F1", "F2", "F3"]},
    "budget": {"type": "integer", "minimum": 1},
    "anomalies": {"type": "integer", "minimum": 0, "description": "specimens the cartographer refused: |delta| != |intervention|, or an empty candidate intersection"},
    "final_map_version": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "map_version", "parent_born", "intervention", "move_kind", "behaviour_delta", "fitness", "confidence", "decoded", "map_version_after"],
        "additionalProperties": false,
        "properties": {
          "seq": {"type": "integer", "minimum": 1},
          "map_version": {"type": "integer", "minimum": 0, "description": "the map version the operator consulted for this move"},
          "parent_born": {"type": "integer", "minimum": 0},
          "intervention": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
          "move_kind": {"enum": ["random", "column"]},
          "behaviour_delta": {
            "type": "array", "uniqueItems": true,
            "items": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 5}, {"type": "integer", "minimum": 0, "maximum": 63}]}
          },
          "fitness": {"type": "integer", "minimum": 0},
          "confidence": {"enum": [1, 2]},
          "decoded": {
            "type": "array",
            "items": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0, "maximum": 5}, {"type": "integer", "minimum": 0, "maximum": 63}]}
          },
          "map_version_after": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
