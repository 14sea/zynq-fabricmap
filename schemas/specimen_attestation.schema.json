{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/14sea/zynq-fabricmap/schemas/specimen_attestation.schema.json",
  "title": "Vivado specimen attestation",
  "description": "Consumer validation shape for producer-emitted specimen_attestation 1.x records. Unknown fields are permitted for additive MINOR evolution.",
  "type": "object",
  "required": ["schema", "schema_version", "inputs", "resolved", "outputs"],
  "properties": {
    "schema": {"const": "specimen_attestation"},
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "inputs": {
      "type": "object",
      "required": ["files", "tclargs", "part", "vivado_version"],
      "properties": {
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "tclargs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "part": {"$ref": "#/$defs/nonempty_string"},
        "vivado_version": {"$ref": "#/$defs/nonempty_string"}
      }
    },
    "resolved": {
      "type": "object",
      "required": [
        "requested_site",
        "requested_bel",
        "resolved_loc",
        "resolved_bel",
        "lock_pins",
        "tile",
        "pin_mapping",
        "pin_mapping_is_identity"
      ],
      "properties": {
        "requested_site": {"$ref": "#/$defs/nonempty_string"},
        "requested_bel": {"$ref": "#/$defs/nonempty_string"},
        "resolved_loc": {"$ref": "#/$defs/nonempty_string"},
        "resolved_bel": {"$ref": "#/$defs/nonempty_string"},
        "lock_pins": {"$ref": "#/$defs/nonempty_string"},
        "tile": {"$ref": "#/$defs/nonempty_string"},
        "pin_mapping": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/nonempty_string"}
        },
        "pin_mapping_is_identity": {"type": "boolean"}
      }
    },
    "outputs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    }
  },
  "$defs": {
    "nonempty_string": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
